{
  "version": 1,
  "description": "Expanded GCP FinOps category taxonomy for demogcp Inform dashboards. OpenCost native category is insufficient (GMP lands in Other).",
  "buckets": [
    { "id": "gmp", "label": "Google Maps Platform" },
    { "id": "compute", "label": "Compute & runtime" },
    { "id": "data", "label": "Data platform" },
    { "id": "ai_ml", "label": "AI / ML" },
    { "id": "network", "label": "Networking" },
    { "id": "ops", "label": "Ops & platform" },
    { "id": "app", "label": "App / Firebase" },
    { "id": "analytics", "label": "Analytics / BI" },
    { "id": "billing", "label": "Billing adjustments" },
    { "id": "other", "label": "Unmapped" }
  ],
  "gmpSubBuckets": [
    {
      "id": "places",
      "label": "Places",
      "services": ["Places API", "Places API (New)"]
    },
    {
      "id": "geocoding",
      "label": "Geocoding",
      "services": ["Geocoding API"]
    },
    {
      "id": "maps_rendering",
      "label": "Maps rendering",
      "services": ["Maps API", "Maps Static API", "Street View Static API"]
    },
    {
      "id": "routes",
      "label": "Routes & mobility",
      "services": ["Directions API", "Distance Matrix API", "Roads API"]
    },
    {
      "id": "location_utils",
      "label": "Location utilities",
      "services": ["Geolocation API", "Time Zone API", "Maps Elevation API"]
    }
  ],
  "serviceToBucket": {
    "Places API": "gmp",
    "Places API (New)": "gmp",
    "Geocoding API": "gmp",
    "Maps API": "gmp",
    "Directions API": "gmp",
    "Distance Matrix API": "gmp",
    "Roads API": "gmp",
    "Maps Static API": "gmp",
    "Street View Static API": "gmp",
    "Maps Elevation API": "gmp",
    "Geolocation API": "gmp",
    "Time Zone API": "gmp",
    "Compute Engine": "compute",
    "App Engine": "compute",
    "Cloud Run": "compute",
    "Cloud Run Functions": "compute",
    "Deep Learning VM": "compute",
    "VM Manager": "compute",
    "BigQuery": "data",
    "Cloud Storage": "data",
    "Cloud SQL": "data",
    "Cloud Bigtable": "data",
    "Dataplex": "data",
    "Firebase Realtime Database": "data",
    "Gemini API": "ai_ml",
    "Vertex AI": "ai_ml",
    "Vertex AI Search": "ai_ml",
    "Cloud Vision API": "ai_ml",
    "Translate": "ai_ml",
    "Claude Fable 5": "ai_ml",
    "Claude Sonnet 4.6": "ai_ml",
    "Claude Sonnet 5": "ai_ml",
    "Claude Haiku 4.5": "ai_ml",
    "Claude Opus 4.8": "ai_ml",
    "Networking": "network",
    "API Gateway": "network",
    "Cloud Pub/Sub": "network",
    "Cloud Monitoring": "ops",
    "Cloud Logging": "ops",
    "Cloud Trace": "ops",
    "Cloud Build": "ops",
    "Cloud Scheduler": "ops",
    "Cloud Tasks": "ops",
    "Secret Manager": "ops",
    "Artifact Registry": "ops",
    "Source Repository": "ops",
    "Google Service Control": "ops",
    "Firebase Hosting": "app",
    "Firebase Data Connect": "app",
    "Looker Studio": "analytics",
    "Invoice": "billing"
  },
  "serviceNamePatterns": [
    { "pattern": "^Claude ", "bucket": "ai_ml" },
    { "pattern": "^Places API", "bucket": "gmp" },
    { "pattern": "^Maps ", "bucket": "gmp" }
  ],
  "defaults": {
    "unmappedBucket": "other",
    "costBasis": "list",
    "discountHighlightPct": 5,
    "topN": 15
  }
}
